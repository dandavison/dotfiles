# Themes for a dark terminal (delta-dark-N) and a light one (delta-light-N), with diff
# backgrounds chosen in OKLCH: removed and added lines at equal lightness, and emph backgrounds
# limited in lightness and chroma so that syntax colors on them stay readable. Only
# delta-dark-2 and delta-light-2 (orange/blue) stay distinct under red-green color blindness.
# delta-dark-6, -7, -8 and delta-light-6 are experiments; each theme's comment says what it is.
# delta-dark-invert-* map delta's default light theme to a dark one by different inversions.

[delta "delta-dark-1"]
    # Red/green, equal lightness for removed and added lines.
    # Backgrounds in OKLCH: lines L=0.235 C=0.062, emph L=0.36 C=0.1, hues 22/145.
    dark = true
    syntax-theme = Monokai Extended
    minus-style = syntax "#360f10"
    minus-emph-style = syntax "#682224"
    plus-style = syntax "#062509"
    plus-emph-style = syntax "#104a17"
    line-numbers-minus-style = "#c86362"
    line-numbers-plus-style = "#67b36a"
    line-numbers-zero-style = "#4d4d4d"
    line-numbers-left-style = "#333333"
    line-numbers-right-style = "#333333"
    file-style = bold "#b1d2f4"
    file-decoration-style = "#44576b" ul
    hunk-header-line-number-style = "#868686"
    hunk-header-decoration-style = "#353e47" box
    commit-decoration-style = "#bb9951" box
    blame-palette = "#000000" "#0f0f0f" "#1d1d1d"

[delta "delta-dark-2"]
    # Orange/blue: removed and added stay distinct under red-green color blindness.
    # Backgrounds in OKLCH: lines L=0.235 C=0.055, emph L=0.36 C=0.095, hues 50/255.
    dark = true
    syntax-theme = Coldark-Dark
    minus-style = syntax "#321504"
    minus-emph-style = syntax "#632b00"
    plus-style = syntax "#0a1e37"
    plus-emph-style = syntax "#153d6d"
    line-numbers-minus-style = "#c36c36"
    line-numbers-plus-style = "#64a1ee"
    line-numbers-zero-style = "#4d4d4d"
    line-numbers-left-style = "#333333"
    line-numbers-right-style = "#333333"
    file-style = bold "#b1d2f4"
    file-decoration-style = "#44576b" ul
    hunk-header-line-number-style = "#868686"
    hunk-header-decoration-style = "#353e47" box
    commit-decoration-style = "#bb9951" box
    blame-palette = "#000000" "#0f0f0f" "#1d1d1d"

[delta "delta-dark-3"]
    # Red/green, low chroma and darker: quieter than delta-dark-1.
    # Backgrounds in OKLCH: lines L=0.205 C=0.035, emph L=0.32 C=0.068, hues 22/145.
    dark = true
    syntax-theme = Catppuccin Mocha
    minus-style = syntax "#251010"
    minus-emph-style = syntax "#502323"
    plus-style = syntax "#0c1b0d"
    plus-emph-style = syntax "#1a3c1c"
    line-numbers-minus-style = "#c86362"
    line-numbers-plus-style = "#67b36a"
    line-numbers-zero-style = "#4d4d4d"
    line-numbers-left-style = "#333333"
    line-numbers-right-style = "#333333"
    file-style = bold "#c5caf5"
    file-decoration-style = "#51536c" ul
    hunk-header-line-number-style = "#868686"
    hunk-header-decoration-style = "#3b3c48" box
    commit-decoration-style = "#bb9951" box
    blame-palette = "#000000" "#0f0f0f" "#1d1d1d"

[delta "delta-dark-4"]
    # Red/green, saturated, with brighter emph backgrounds: close to delta's default look.
    # Backgrounds in OKLCH: lines L=0.225 C=0.075, emph L=0.37 C=0.125, hues 25/145.
