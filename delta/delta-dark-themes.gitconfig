[delta "delta-dark-6"]
    # Red/green, lighter and more colorful lines: less murky, at some cost to contrast.
    # Backgrounds in OKLCH: lines L=0.3 C=0.08, emph L=0.39 C=0.11, hues 22/145.
    dark = true
    syntax-theme = Catppuccin Mocha
    minus-style = syntax "#4f1a1b"
    minus-emph-style = syntax "#752729"
    plus-style = syntax "#0d3811"
    plus-emph-style = syntax "#11531a"
    line-numbers-minus-style = "#c86362"
    line-numbers-plus-style = "#67b36a"
    line-numbers-zero-style = "#4d4d4d"
    line-numbers-left-style = "#333333"
    line-numbers-right-style = "#333333"
    file-style = bold "#c5caf5"
    file-decoration-style = "#51536c" ul
    hunk-header-line-number-style = "#868686"
    hunk-header-decoration-style = "#3b3c48" box
    commit-decoration-style = "#bb9951" box
    blame-palette = "#000000" "#0f0f0f" "#1d1d1d"

[delta "delta-dark-7"]
    # Orange-red/teal: hues chosen away from those of Monokai's text (pink, green, yellow).
    # Backgrounds in OKLCH: lines L=0.235 C=0.062, emph L=0.36 C=0.1, hues 45/180.
    dark = true
    syntax-theme = Monokai Extended
    minus-style = syntax "#351202"
    minus-emph-style = syntax "#662703"
    plus-style = syntax "#00271f"
    plus-emph-style = syntax "#004b3f"
    line-numbers-minus-style = "#c56a3e"
    line-numbers-plus-style = "#00b8a1"
    line-numbers-zero-style = "#4d4d4d"
    line-numbers-left-style = "#333333"
    line-numbers-right-style = "#333333"
    file-style = bold "#b1d2f4"
    file-decoration-style = "#44576b" ul
    hunk-header-line-number-style = "#868686"
    hunk-header-decoration-style = "#353e47" box
    commit-decoration-style = "#bb9951" box
    blame-palette = "#000000" "#0f0f0f" "#1d1d1d"

[delta "delta-dark-8"]
    # Red/green, changed words bold and underlined, on a background only a little lighter.
    # Backgrounds in OKLCH: lines L=0.235 C=0.062, emph L=0.275 C=0.075, hues 22/145.
    dark = true
    syntax-theme = Monokai Extended
    minus-style = syntax "#360f10"
    minus-emph-style = syntax bold ul "#461516"
    plus-style = syntax "#062509"
    plus-emph-style = syntax bold ul "#09310d"
    line-numbers-minus-style = "#c86362"
    line-numbers-plus-style = "#67b36a"
    line-numbers-zero-style = "#4d4d4d"
    line-numbers-left-style = "#333333"
    line-numbers-right-style = "#333333"
    file-style = bold "#b1d2f4"
    file-decoration-style = "#44576b" ul
    hunk-header-line-number-style = "#868686"
    hunk-header-decoration-style = "#353e47" box
    commit-decoration-style = "#bb9951" box
    blame-palette = "#000000" "#0f0f0f" "#1d1d1d"

