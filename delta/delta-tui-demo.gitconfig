[pager]
    diff = delta --tui
    show = delta --tui
    log = delta --tui

# The rest of this is not essential -- just suggestions to give an idea of what's available

[pretty]
commit-format = tformat:%n%n▸ %h %C(blue)%an %C(blue)%ar%C(auto)%d%C(reset)%n%n    %C(green)%s%C(auto)
commit-format-full = tformat:%n%n▸ %h %C(blue)%an %C(blue)%ar%C(auto)%d%C(reset)%n%n%w(0,4,4)%C(green)%s%C(reset)%n%+b


[delta-tui]
    log-args = --stat
    log-args = --date=relative
    log-args = --pretty=commit-format
    show-args = --pretty=commit-format-full
    file-header = stat
    start-folded = true

    # Not in demo config
    recent-commits-limit = 0
    stash-list-limit = 0

[delta-tui "general.commands"]
	pr-comments = pr-fetch-comments
	pr-comments-remove = pr-fetch-comments --remove


[delta-tui "general.views"]
	diff = git diff {commit}...


[delta]
    commit-regex = ^(▸|commit )
    commit-decoration-style = blue ol
    features = my-theme

[delta "my-theme"]
    file-decoration-style = "magenta ul"
    file-added-label = •
    file-modified-label = •
    file-removed-label = •
    file-renamed-label = •
    navigate-regex = ^•


[include]
    path = /Users/dan/src/devenv/dotfiles/delta/themes.gitconfig


[delta-tui "general.diff-renderer.feature-keys"]
	line-numbers = L
	side-by-side = S
	pr-comments = C
	pr-comments-remove = R
	diff = D
