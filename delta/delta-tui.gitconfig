[pretty]
# Shared by shell log aliases (_gl) and gitu's log renderer.
commit-format = tformat:%n%n▸ %h %C(blue)%an %C(blue)%ar%C(auto)%d%C(reset)%n%n    %C(green)%s%C(auto)
# With whole message; shared by gs and gitu's commit view.
commit-format-full = tformat:%n%n▸ %h %C(blue)%an %C(blue)%ar%C(auto)%d%C(reset)%n%n%w(0,4,4)%C(green)%s%C(reset)%n%+b


# delta --tui (the TUI). These are options in delta's config that delta itself does not use.
# They can go in a [delta "feature"] section too, to be in force while that feature is.
[delta]
    file-header = stat
    start-folded = true
    log-args = --stat
    log-args = --date=relative
    log-args = --pretty=commit-format
    show-args = --pretty=commit-format-full
    recent-commits-limit = 0
    stash-list-limit = 0
    # alt+enter opens the file here, as in fsi and rgi: wormhole opens it in
    # the worktree's editor workspace.
    alt-editor = wormhole open
    # collapsed-sections = branch_status

    # bind = root.discard k
    # bind = root.quit q
    # bind = root.quit esc
    # bind = root.quit left
    # bind = root.move-down ctrl+down
    # bind = root.move-down-line down
    # bind = root.move-up ctrl+up
    # bind = root.move-up-line up
    # bind = root.hide-file ctrl+k

    view = diff git diff {commit}...

    command = html {command} --color=always | delta | aha > /tmp/diff.html && open /tmp/diff.html
    command = pr-comments pr-fetch-comments
    command = pr-comments-remove pr-fetch-comments --remove
    command = send-message-to-agent redis-cli XADD delta '*' message-to-agent "{input}"

    feature-key = line-numbers L
    feature-key = html %
    feature-key = diff D
    feature-key = pr-comments C
    feature-key = pr-comments-remove R
    feature-key = plus-minus-markers =
    feature-key = side-by-side S
    feature-key = comments-compact W
    feature-key = difftastic (
    feature-key = code *
    feature-key = send-message-to-agent @
