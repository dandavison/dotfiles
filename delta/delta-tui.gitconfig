[pretty]
# Shared by shell log aliases (_gl) and gitu's log renderer.
commit-format = tformat:%n%n▸ %h %C(blue)%an %C(blue)%ar%C(auto)%d%C(reset)%n%n    %C(green)%s%C(auto)
# With whole message; shared by gs and gitu's commit view.
commit-format-full = tformat:%n%n▸ %h %C(blue)%an %C(blue)%ar%C(auto)%d%C(reset)%n%n%w(0,4,4)%C(green)%s%C(reset)%n%+b


[delta-tui]
    file-header = stat
    start-folded = true
    log-args = --stat
    log-args = --date=relative
    log-args = --pretty=commit-format
    show-args = --pretty=commit-format-full
    recent-commits-limit = 0
    stash-list-limit = 0
    # alt+enter opens the file here, as in fsi and rgi: wormhole opens it in
    # the worktree's editor workspace.
    alt-editor = wormhole open
    # collapsed-sections = branch_status


 # [delta-tui "bindings.root"]
 #     discard = k
 #     quit = q
 #     quit = esc
 #     quit = left
 #     move-down = ctrl+down
 #     move-down-line = down
 #     move-up = ctrl+up
 #     move-up-line = up
 #     hide-file = ctrl+k

[delta-tui "general.views"]
	diff = git diff {commit}...

[delta-tui "general.commands"]
	html = {command} --color=always | delta | aha > /tmp/diff.html && open /tmp/diff.html
	pr-comments = pr-fetch-comments
	pr-comments-remove = pr-fetch-comments --remove

[delta-tui "general.diff-renderer.feature-keys"]
	line-numbers = L
	html = %
	diff = D
	github-pr-links = @
	pr-comments = C
	pr-comments-remove = R
	plus-minus-markers = =
	side-by-side = S
	difftastic = *
	comments-compact = W
