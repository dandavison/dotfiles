[core]
    pager = delta

[pager]
    log = delta --gitu --pager
    diff = delta --gitu --pager
    show = delta --gitu --pager

[sequence]
    editor = delta --gitu sequence-editor

[interactive]
    diffFilter = delta --color-only

[include]
    path = /Users/dan/src/delta/themes.gitconfig

[delta]
    light = true
    context-lines = 3
    features = navigate whole-file-hunks
    hyperlinks = true
    relative-paths = true
    hyperlinks-file-link-format = "http://wormhole:7117/file/{path}:{line}?land-in=editor"
    grep-file-style = red
    commit-decoration-style = blue ol
    commit-style = raw
    # The custom log format and git's own, so delta marks the commit in either
    # and gitu can make the rows of both navigable.
    commit-regex = ^(▸|commit )
    side-by-side-fill-empty = true
    minus-style = normal "#ffe9e9"
    minus-emph-style = normal "#ffd0d0"
    plus-style = syntax "#dfffe0"
    plus-emph-style = syntax "#bcf2bd"
    wrap-max-lines = unlimited

[delta "side-by-side-hunk"]
    side-by-side = hunk

[delta "whole-file-hunks"]
    # set diff.context (-U) to a large value
    # hunk-header-style = omit
    # navigate visits file boundaries only
    file-style="bold cyan #EEEEEE"
    file-decoration-style="magenta ul"
    file-added-label = •
    file-modified-label = •
    file-removed-label = •
    file-renamed-label = •
    line-numbers-left-format = ""
    line-numbers-right-format = "{np:^4}│"
    line-numbers-minus-right-format = "{np:^4}┃"
    line-numbers-plus-right-format = "{np:^4}┃"
    navigate-regex = ^•

[delta "hunk-header-with-filepath"]
    file-style = omit
    hunk-header-decoration-style = blue box
    hunk-header-file-style = red
    hunk-header-line-number-style = "#067a00"
    hunk-header-style = file line-number syntax

# delta --gitu (the TUI). A key is its gitu config path, with dashes for
# underscores; no subsection means "general". A list is one line per item.
[delta-tui]
    collapsed-sections = branch_status
    recent-commits-limit = 0
    stash-list-limit = 0
    max-input-bytes = 3000000
    # The --pretty formats are defined in git config.
    log-args = --stat
    log-args = --date=relative
    log-args = --pretty=commit-format
    show-args = --pretty=commit-format-full
    file-header = stat
    start-folded = true

[delta-tui "general.diff-renderer"]
    features = *

[delta-tui "general.diff-renderer.feature-keys"]
    keep-plus-minus-markers = +
    line-numbers = L
    side-by-side-hunk = S

[delta-tui "bindings.root"]
    discard = k
    quit = q
    quit = esc
    quit = left
    move-down = ctrl+down
    move-down-line = down
    move-up = ctrl+up
    move-up-line = up
    hide-file = ctrl+k

[delta-tui "bindings.rebase-todo"]
    rebase-todo-drop = ctrl+k

# GitHub light theme palette:
#   fg #333333  gray #969896  pink #a71d5d  blue #0086b3
#   purple #795da3  string #183691  green #63a35c/#009926
#   orange #df5000  red #f93232
[delta-tui "style"]
    separator = dim
    info-msg = bold "#009926"
    error-msg = bold "#f93232"
    command = bold "#0086b3"
    prompt = dim "#0086b3"
    section-header = bold "#000000"
    file-header = "#6a737d"
    hunk-header = "#0086b3"
    cursor = "#0086b3"
    selection-bar = dim "#0086b3"
    selection-line = bold
    hash = "#0086b3"
    branch = "#63a35c"
    remote = "#df5000"
    tag = "#0086b3"

[delta-tui "style.menu"]
    heading = bold "#0086b3"
    key = "#a71d5d"
    active-arg = bold "#df5000"

[delta-tui "style.picker"]
    prompt = "#0086b3"
    info = dim
    selection-line = bold
    matched = bold "#a71d5d"

[delta-tui "style.rebase-todo"]
    reword = bold "#f93232"
    edit = bold "#f93232"
    squash = bold "#f93232"
    fixup = bold "#f93232"
    drop = bold "#f93232"

[delta-tui "style.blame"]
    line-num = dim
    code-line = dim




[diff "json-diff"]
	command = json-diff --color "$2" "$5" || true
