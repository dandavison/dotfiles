[core]
    pager = delta

[pager]
    log = delta tui
    diff = delta tui
    show = delta tui

[sequence]
    editor = delta tui sequence-editor

[interactive]
    diffFilter = delta --color-only

[include]
    path = /Users/dan/src/devenv/dotfiles/delta/themes.gitconfig
    

[delta]
    features = dan line-numbers comments
    width = variable
    navigate = true
    hyperlinks = true
    wrap-max-lines = unlimited
    commit-regex = ^(▸|commit )
    relative-paths = true
    grep-file-style = red
    commit-decoration-style = blue ol
    file-decoration-style="magenta ul"
    commit-style = raw
    side-by-side-fill-empty = true
    file-added-label = •
    file-modified-label = •
    file-removed-label = •
    file-renamed-label = •
    navigate-regex = ^•
    # line-numbers-left-format = "{nm:^4}│"
    # line-numbers-minus-left-format = "{nm:^4}┃"
    # line-numbers-plus-left-format = "{nm:^4}┃"
    # line-numbers-right-format = "│{np:^4}│"
    # line-numbers-minus-right-format = "┃{np:^4}┃"
    # line-numbers-plus-right-format = "┃{np:^4}┃"

    

[delta "dan-light"]
    minus-style = normal "#ffe9e9"
    minus-emph-style = normal "#ffd0d0"
    plus-style = syntax "#dfffe0"
    plus-emph-style = syntax "#bcf2bd"
    file-style="bold cyan #EEEEEE"


[delta "dan"]
    hyperlinks-file-link-format = "http://wormhole:7117/file/{path}:{line}?land-in=editor"
    line-numbers = true
    side-by-side = hunk,140
    # Unified mode: one column showing new-file line numbers; removed lines have no number.
    # These are here rather than in [delta "line-numbers"] because that section would beat
    # [delta "side-by-side"], which restores the left column in side-by-side mode.
    line-numbers-left-format = ""
    line-numbers-right-format = "{np:^4}┃"

[delta "code"]
    minus-style = omit
    plus-style = syntax
    plus-emph-style = syntax
    plus-non-emph-style = syntax
    side-by-side = false
    line-numbers-left-format = ""

# PR review comments in delta --tui. delta itself does not use these options.
# They are in a feature rather than in [delta] so that a feature turned on
# later, such as comments-compact, can change them. The background suits a
# light terminal.
[delta "comments"]
    comment-style = normal "#eef3fb"
    comment-author-style = bold "#0550ae"
    comment-timestamp-style = italic "#6e7781"
    comment-count-style = bold "#0550ae"
    comment-decoration-style = "#0550ae" box
    # Unset: times are shown as how long ago, e.g. "an hour ago".
    # comment-timestamp-format = "%Y-%m-%d %H:%M"
    # The box a comment is written in (i), unless set the same as the comments.
    # comment-editor-style = normal "#fff8e5"
    # comment-editor-decoration-style = bold "#9a6700" box

# PR review comments for a dark terminal, in GitHub's dark theme's colors.
[delta "comments-dark"]
    comment-style = normal "#161b22"
    comment-author-style = bold "#58a6ff"
    comment-timestamp-style = italic "#8b949e"
    comment-count-style = bold "#58a6ff"
    comment-decoration-style = "#388bfd" box

# PR review comments to go with the collared-trogon theme: its navy box color and
# grey, and Nord's blue, on a background between the theme's own.
[delta "comments-collared-trogon"]
    comment-style = normal "#1a2530"
    comment-author-style = bold "#88c0d0"
    comment-timestamp-style = italic "#999999"
    comment-count-style = bold "#88c0d0"
    comment-decoration-style = "#2b5f80" box

# PR review comments without the box: a bar down each thread's left, and dates
# instead of how long ago. Toggled in delta --tui with W.
[delta "comments-compact"]
    comment-decoration-style = "#0550ae"
    comment-timestamp-format = "%Y-%m-%d %H:%M"

# PR review comments between heavy lines over and under each thread. Toggle it
# in delta --tui from the feature list (H).
[delta "comments-lined"]
    comment-decoration-style = bold "#0550ae" ul ol
    comment-author-style = bold magenta
    comment-count-style = bold magenta

# Links go to the line in the worktree's GitHub PR instead of the editor, for reviewing.
# A feature rather than a [delta] setting, since [delta] settings override features.
[delta "github-pr-links"]
    hyperlinks-file-link-format = "http://wormhole:7117/file/{path}:{line}?land-in=github-pr"



[delta "line-numbers"]
    # Requires a delta built from dandavison:line-numbers-style-line (6b262740)
    line-numbers = true
    line-numbers-minus-style = red bold
    line-numbers-plus-style = green bold
    line-numbers-zero-style = "#999999"
    line-numbers-left-style = line
    line-numbers-right-style = line

[delta "side-by-side"]
    line-numbers-left-format = "│{nm:^4}┃"
    line-numbers-right-format = "│{np:^4}┃"

[delta "whole-file-hunks"]
    # set diff.context (-U) to a large value
    # hunk-header-style = omit
    # navigate visits file boundaries only
    line-numbers-left-format = ""
    line-numbers-right-format = "{np:^4}│"
    line-numbers-minus-right-format = "{np:^4}┃"
    line-numbers-plus-right-format = "{np:^4}┃"

[delta "hunk-header-with-filepath"]
    file-style = omit
    hunk-header-decoration-style = blue box
    hunk-header-file-style = red
    hunk-header-line-number-style = "#067a00"
    hunk-header-style = file line-number syntax




[diff "json-diff"]
	command = json-diff --color "$2" "$5" || true
