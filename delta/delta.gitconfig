[core]
    pager = delta

[pager]
    log = delta --tui
    diff = delta --tui
    show = delta --tui

[sequence]
    editor = delta --tui sequence-editor

[interactive]
    diffFilter = delta --color-only

[include]
    path = /Users/dan/src/delta/themes.gitconfig
    # path = /Users/dan/worktrees/delta/gitu/delta/themes.gitconfig
    

[delta]
    navigate = true
    hyperlinks = true
    hyperlinks-file-link-format = "http://wormhole:7117/file/{path}:{line}?land-in=editor"
    wrap-max-lines = unlimited
    commit-regex = ^(▸|commit )
    relative-paths = true
    grep-file-style = red
    commit-decoration-style = blue ol
    commit-style = raw
    side-by-side-fill-empty = true
    file-style="bold cyan #EEEEEE"
    file-decoration-style="magenta ul"
    file-added-label = •
    file-modified-label = •
    file-removed-label = •
    file-renamed-label = •
    navigate-regex = ^•
    # line-numbers-left-format = "{nm:^4}│"
    # line-numbers-minus-left-format = "{nm:^4}┃"
    # line-numbers-plus-left-format = "{nm:^4}┃"
    # line-numbers-right-format = "│{np:^4}│"
    # line-numbers-minus-right-format = "┃{np:^4}┃"
    # line-numbers-plus-right-format = "┃{np:^4}┃"

    

[delta "dan-light"]
    minus-style = normal "#ffe9e9"
    minus-emph-style = normal "#ffd0d0"
    plus-style = syntax "#dfffe0"
    plus-emph-style = syntax "#bcf2bd"


[delta "side-by-side-hunk"]
    side-by-side = hunk

[delta "whole-file-hunks"]
    # set diff.context (-U) to a large value
    # hunk-header-style = omit
    # navigate visits file boundaries only
    line-numbers-left-format = ""
    line-numbers-right-format = "{np:^4}│"
    line-numbers-minus-right-format = "{np:^4}┃"
    line-numbers-plus-right-format = "{np:^4}┃"

[delta "hunk-header-with-filepath"]
    file-style = omit
    hunk-header-decoration-style = blue box
    hunk-header-file-style = red
    hunk-header-line-number-style = "#067a00"
    hunk-header-style = file line-number syntax




[diff "json-diff"]
	command = json-diff --color "$2" "$5" || true
